{
  "$defs": {
    "DetectionCandidateRefs": {
      "additionalProperties": false,
      "description": "Pinned candidate package/model/rule identity bound into the artifact.",
      "properties": {
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_version": {
          "minimum": 1,
          "title": "Package Version",
          "type": "integer"
        },
        "package_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Package Content Hash",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Rule Ids",
          "type": "array"
        },
        "feature_contract_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Feature Contract Version",
          "type": "string"
        },
        "detection_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Detection Scope Id",
          "type": "string"
        },
        "scope_revision_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Revision Id"
        },
        "model_release_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Id"
        },
        "model_release_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Hash"
        }
      },
      "required": [
        "package_id",
        "package_version",
        "package_content_hash",
        "feature_contract_version",
        "detection_scope_id"
      ],
      "title": "DetectionCandidateRefs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen detection evaluation configuration bound into the artifact.",
  "properties": {
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "effective_cutoff_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Max per-case replay cutoff bound into the artifact (>= manifest default).",
      "title": "Effective Cutoff At"
    },
    "replay_mode": {
      "default": "detection_shadow",
      "minLength": 1,
      "title": "Replay Mode",
      "type": "string"
    },
    "replay_fidelity": {
      "default": "shadow_runtime_v1",
      "description": "Shadow runtime replay against #624–#628 outputs. Does not use post-promotion Event severity or agent conclusions.",
      "minLength": 1,
      "title": "Replay Fidelity",
      "type": "string"
    },
    "candidate_refs": {
      "$ref": "#/$defs/DetectionCandidateRefs"
    },
    "candidate_refs_entries": {
      "items": {
        "$ref": "#/$defs/DetectionCandidateRefs"
      },
      "title": "Candidate Refs Entries",
      "type": "array"
    },
    "candidate_set_hash": {
      "default": "",
      "maxLength": 64,
      "minLength": 0,
      "title": "Candidate Set Hash",
      "type": "string"
    },
    "scorer_ids": {
      "items": {
        "type": "string"
      },
      "title": "Scorer Ids",
      "type": "array"
    },
    "extra": {
      "additionalProperties": true,
      "title": "Extra",
      "type": "object"
    }
  },
  "required": [
    "seed",
    "cutoff_at",
    "candidate_refs"
  ],
  "title": "DetectionEvaluationConfig",
  "type": "object"
}
