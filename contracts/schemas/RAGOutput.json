{
  "$defs": {
    "AttackTechniqueMatch": {
      "additionalProperties": false,
      "properties": {
        "technique_id": {
          "title": "Technique Id",
          "type": "string"
        },
        "technique_name": {
          "title": "Technique Name",
          "type": "string"
        },
        "tactics": {
          "items": {
            "type": "string"
          },
          "title": "Tactics",
          "type": "array"
        },
        "match_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Match Confidence",
          "type": "number"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        }
      },
      "required": [
        "technique_id",
        "technique_name",
        "match_confidence",
        "citation_id"
      ],
      "title": "AttackTechniqueMatch",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "kb_name": {
          "title": "Kb Name",
          "type": "string"
        },
        "quoted_text": {
          "title": "Quoted Text",
          "type": "string"
        },
        "relevance_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance Score",
          "type": "number"
        },
        "corpus_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Id"
        },
        "release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Id"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        }
      },
      "required": [
        "citation_id",
        "chunk_id",
        "kb_name",
        "quoted_text",
        "relevance_score"
      ],
      "title": "Citation",
      "type": "object"
    },
    "EventType": {
      "description": "Supported security event types (intro §1); extensible via scenario packs.",
      "enum": [
        "account_anomaly",
        "host_compromise",
        "data_exfiltration",
        "insider_threat",
        "malicious_process",
        "suspicious_domain",
        "lateral_movement",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FinalVerdict": {
      "description": "Verdict label, independent from EventStatus.",
      "enum": [
        "none",
        "possible_false_positive",
        "false_positive",
        "confirmed_threat"
      ],
      "title": "FinalVerdict",
      "type": "string"
    },
    "FpSimilarity": {
      "additionalProperties": false,
      "properties": {
        "max_score": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Score",
          "type": "number"
        },
        "matched_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Case Id"
        },
        "matched_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Pattern"
        }
      },
      "title": "FpSimilarity",
      "type": "object"
    },
    "KnowledgeReleaseLifecycleState": {
      "description": "Release lifecycle — activation/retirement are server-owned transitions.",
      "enum": [
        "draft",
        "staged",
        "active",
        "retired",
        "failed"
      ],
      "title": "KnowledgeReleaseLifecycleState",
      "type": "string"
    },
    "OrgContextMatch": {
      "additionalProperties": false,
      "description": "Exact org-context hit. Evidence only — never auto-closes or sets verdict.",
      "properties": {
        "kind": {
          "enum": [
            "allowed_destination",
            "allowed_source",
            "time_window",
            "account_role",
            "person_status",
            "data_handling",
            "security_product"
          ],
          "title": "Kind",
          "type": "string"
        },
        "matched_value": {
          "title": "Matched Value",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "match_type": {
          "default": "exact",
          "title": "Match Type",
          "type": "string"
        },
        "match_confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Match Confidence",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "matched_value",
        "explanation",
        "citation_id",
        "chunk_id"
      ],
      "title": "OrgContextMatch",
      "type": "object"
    },
    "PlaybookRef": {
      "additionalProperties": false,
      "description": "Immutable playbook version/hash reference — not a bare playbook_id string.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "playbook_id": {
          "pattern": "^pb-[0-9a-fA-F]{8}$",
          "title": "Playbook Id",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Release Id",
          "type": "string"
        },
        "release_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Release Version",
          "type": "string"
        },
        "content_hash": {
          "description": "SHA-256 of canonical playbook object JSON",
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        },
        "bundle_content_hash": {
          "description": "SHA-256 of canonical release bundle JSON",
          "maxLength": 64,
          "minLength": 64,
          "title": "Bundle Content Hash",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "corpus_id": {
          "default": "playbook_soar",
          "minLength": 1,
          "title": "Corpus Id",
          "type": "string"
        },
        "lifecycle_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeReleaseLifecycleState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Release lifecycle at pin time (audit only)"
        }
      },
      "required": [
        "playbook_id",
        "release_id",
        "release_version",
        "content_hash",
        "bundle_content_hash"
      ],
      "title": "PlaybookRef",
      "type": "object"
    },
    "RetrievalMetrics": {
      "description": "RAG-segment timings. Approval / writeback / Celery wait are out of scope.",
      "properties": {
        "rewrite_ms": {
          "default": 0.0,
          "title": "Rewrite Ms",
          "type": "number"
        },
        "retrieve_ms": {
          "default": 0.0,
          "title": "Retrieve Ms",
          "type": "number"
        },
        "rrf_ms": {
          "default": 0.0,
          "title": "Rrf Ms",
          "type": "number"
        },
        "rerank_ms": {
          "default": 0.0,
          "title": "Rerank Ms",
          "type": "number"
        },
        "total_ms": {
          "default": 0.0,
          "title": "Total Ms",
          "type": "number"
        },
        "llm_rewrite_calls": {
          "default": 0,
          "title": "Llm Rewrite Calls",
          "type": "integer"
        },
        "org_context_exact_hit": {
          "default": false,
          "title": "Org Context Exact Hit",
          "type": "boolean"
        },
        "constraint_channel": {
          "default": false,
          "title": "Constraint Channel",
          "type": "boolean"
        },
        "retrieval_action": {
          "default": "",
          "description": "sufficient | uncertain | conflict. Empty when unset.",
          "title": "Retrieval Action",
          "type": "string"
        }
      },
      "title": "RetrievalMetrics",
      "type": "object"
    },
    "SimilarCaseSummary": {
      "additionalProperties": false,
      "description": "Compact HistoryCase digest for RAG similar_cases (full model lands later).",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "final_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "case_id"
      ],
      "title": "SimilarCaseSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attack_techniques": {
      "items": {
        "$ref": "#/$defs/AttackTechniqueMatch"
      },
      "title": "Attack Techniques",
      "type": "array"
    },
    "fp_similarity": {
      "$ref": "#/$defs/FpSimilarity"
    },
    "similar_cases": {
      "items": {
        "$ref": "#/$defs/SimilarCaseSummary"
      },
      "title": "Similar Cases",
      "type": "array"
    },
    "playbook_refs": {
      "items": {
        "$ref": "#/$defs/PlaybookRef"
      },
      "title": "Playbook Refs",
      "type": "array"
    },
    "org_context_matches": {
      "items": {
        "$ref": "#/$defs/OrgContextMatch"
      },
      "title": "Org Context Matches",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "knowledge_query_plan": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Release-pinned query plans keyed by kb_name (attack_kb, playbook_kb)",
      "title": "Knowledge Query Plan"
    },
    "retrieval_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
    }
  },
  "title": "RAGOutput",
  "type": "object"
}
