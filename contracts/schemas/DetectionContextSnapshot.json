{
  "$defs": {
    "DetectionContextAttackRef": {
      "additionalProperties": false,
      "description": "ATT&CK technique pin \u2014 structured ids only, no narrative text.",
      "properties": {
        "technique_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Technique Id",
          "type": "string"
        },
        "technique_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Name"
        },
        "source": {
          "default": "unknown",
          "enum": [
            "rule",
            "evaluation",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "technique_id"
      ],
      "title": "DetectionContextAttackRef",
      "type": "object"
    },
    "DetectionContextCoverageSummary": {
      "additionalProperties": false,
      "description": "Coverage/status rollup for pinned feature snapshots.",
      "properties": {
        "feature_snapshot_count": {
          "default": 0,
          "minimum": 0,
          "title": "Feature Snapshot Count",
          "type": "integer"
        },
        "ready_snapshot_count": {
          "default": 0,
          "minimum": 0,
          "title": "Ready Snapshot Count",
          "type": "integer"
        },
        "insufficient_history_count": {
          "default": 0,
          "minimum": 0,
          "title": "Insufficient History Count",
          "type": "integer"
        },
        "insufficient_coverage_count": {
          "default": 0,
          "minimum": 0,
          "title": "Insufficient Coverage Count",
          "type": "integer"
        }
      },
      "title": "DetectionContextCoverageSummary",
      "type": "object"
    },
    "DetectionContextEvaluationRefs": {
      "additionalProperties": false,
      "description": "Evaluation artifact pins from governance binding.",
      "properties": {
        "evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "artifact_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Artifact Hash",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "dataset_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Dataset Content Hash",
          "type": "string"
        },
        "code_sha": {
          "maxLength": 64,
          "minLength": 7,
          "title": "Code Sha",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "artifact_hash",
        "dataset_id",
        "dataset_version",
        "dataset_content_hash",
        "code_sha"
      ],
      "title": "DetectionContextEvaluationRefs",
      "type": "object"
    },
    "DetectionContextEvidenceRef": {
      "additionalProperties": false,
      "description": "One ordered evidence anchor \u2014 investigation namespace refs only.",
      "properties": {
        "ref_kind": {
          "$ref": "#/$defs/DetectionContextEvidenceRefKind"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "ordinal"
      ],
      "title": "DetectionContextEvidenceRef",
      "type": "object"
    },
    "DetectionContextEvidenceRefKind": {
      "description": "Ordered evidence anchor kinds pinned into a snapshot.",
      "enum": [
        "behavior_observation",
        "feature_snapshot",
        "source_record",
        "promotion"
      ],
      "title": "DetectionContextEvidenceRefKind",
      "type": "string"
    },
    "DetectionContextGovernanceRefs": {
      "additionalProperties": false,
      "description": "Governance decision pins frozen at promotion time.",
      "properties": {
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "binding_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Binding Hash",
          "type": "string"
        },
        "decision_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Decision Hash",
          "type": "string"
        },
        "candidate_set_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Candidate Set Hash",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "binding_hash",
        "decision_hash",
        "candidate_set_hash"
      ],
      "title": "DetectionContextGovernanceRefs",
      "type": "object"
    },
    "DetectionContextReleaseRefs": {
      "additionalProperties": false,
      "description": "Pinned release identities for candidate/rule/model/feature/scope.",
      "properties": {
        "candidate_detection_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Detection Id",
          "type": "string"
        },
        "candidate_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Candidate Content Hash",
          "type": "string"
        },
        "package_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Package Id",
          "type": "string"
        },
        "package_version": {
          "minimum": 1,
          "title": "Package Version",
          "type": "integer"
        },
        "package_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Package Content Hash",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minimum": 1,
          "title": "Rule Version",
          "type": "integer"
        },
        "feature_contract_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Feature Contract Version",
          "type": "string"
        },
        "detection_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Detection Scope Id",
          "type": "string"
        },
        "scope_revision_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Revision Id"
        },
        "model_release_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Id"
        },
        "model_release_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Hash"
        }
      },
      "required": [
        "candidate_detection_id",
        "candidate_content_hash",
        "package_id",
        "package_version",
        "package_content_hash",
        "rule_id",
        "rule_version",
        "feature_contract_version",
        "detection_scope_id"
      ],
      "title": "DetectionContextReleaseRefs",
      "type": "object"
    },
    "DetectionContextScoreSummary": {
      "additionalProperties": false,
      "description": "Typed detection scores \u2014 no free-text model output.",
      "properties": {
        "matched_value": {
          "minimum": 0,
          "title": "Matched Value",
          "type": "number"
        },
        "detection_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Score"
        },
        "severity": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "operator": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Operator",
          "type": "string"
        }
      },
      "required": [
        "matched_value",
        "severity",
        "operator"
      ],
      "title": "DetectionContextScoreSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable detection context revision for one promoted event.",
  "properties": {
    "snapshot_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_revision": {
      "minimum": 1,
      "title": "Event Revision",
      "type": "integer"
    },
    "promotion_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Promotion Id",
      "type": "string"
    },
    "promotion_link_revision": {
      "minimum": 1,
      "title": "Promotion Link Revision",
      "type": "integer"
    },
    "promotion_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Promotion Key",
      "type": "string"
    },
    "release_refs": {
      "$ref": "#/$defs/DetectionContextReleaseRefs"
    },
    "governance_refs": {
      "$ref": "#/$defs/DetectionContextGovernanceRefs"
    },
    "evaluation_refs": {
      "$ref": "#/$defs/DetectionContextEvaluationRefs"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/DetectionContextEvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "attack_refs": {
      "items": {
        "$ref": "#/$defs/DetectionContextAttackRef"
      },
      "title": "Attack Refs",
      "type": "array"
    },
    "scores": {
      "$ref": "#/$defs/DetectionContextScoreSummary"
    },
    "coverage": {
      "$ref": "#/$defs/DetectionContextCoverageSummary"
    },
    "projection_errors": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Projection Errors",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "supersedes_snapshot_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Snapshot Id"
    },
    "content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "snapshot_id",
    "tenant_id",
    "event_id",
    "event_revision",
    "promotion_id",
    "promotion_link_revision",
    "promotion_key",
    "release_refs",
    "governance_refs",
    "evaluation_refs",
    "scores",
    "content_hash",
    "idempotency_key"
  ],
  "title": "DetectionContextSnapshot",
  "type": "object"
}
