{
  "$defs": {
    "AgentTaskContextRef": {
      "additionalProperties": false,
      "description": "Allowlisted pointer to EventContext field or prior artifact.",
      "properties": {
        "ref_kind": {
          "enum": [
            "event_context_field",
            "artifact"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "AgentTaskContextRef",
      "type": "object"
    },
    "AgentTaskGoal": {
      "additionalProperties": false,
      "description": "Versioned typed task input — not free-text instructions.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/AgentTaskType"
        },
        "context_refs": {
          "items": {
            "$ref": "#/$defs/AgentTaskContextRef"
          },
          "maxItems": 16,
          "title": "Context Refs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "tool_call_grant_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Grant Id"
        }
      },
      "required": [
        "task_type"
      ],
      "title": "AgentTaskGoal",
      "type": "object"
    },
    "AgentTaskStatus": {
      "description": "Task lifecycle — at-least-once delivery with exactly-once terminal transitions.",
      "enum": [
        "queued",
        "claimed",
        "running",
        "completed",
        "failed",
        "cancelled",
        "expired",
        "dead",
        "manual"
      ],
      "title": "AgentTaskStatus",
      "type": "string"
    },
    "AgentTaskType": {
      "description": "Phase A task types — single coordinator, no DAG engine.",
      "enum": [
        "evidence_collect",
        "risk_score",
        "report_generate"
      ],
      "title": "AgentTaskType",
      "type": "string"
    },
    "SideEffectStatus": {
      "enum": [
        "none",
        "unknown"
      ],
      "title": "SideEffectStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Durable coordination ledger row.",
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/AgentTaskType"
    },
    "goal": {
      "$ref": "#/$defs/AgentTaskGoal"
    },
    "status": {
      "$ref": "#/$defs/AgentTaskStatus"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "claim_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claim Owner"
    },
    "fencing_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fencing Token"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "side_effect_status": {
      "$ref": "#/$defs/SideEffectStatus",
      "default": "none"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "event_id",
    "tenant_id",
    "task_type",
    "goal",
    "status",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "title": "AgentTask",
  "type": "object"
}
