{
  "$defs": {
    "CaseObservation": {
      "additionalProperties": false,
      "description": "Deterministic mock-replay observation for one evaluation case.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "slice_type": {
          "$ref": "#/$defs/SliceType"
        },
        "observed_case_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Case Label"
        },
        "observed_final_verdict": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Final Verdict"
        },
        "observed_risk_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Risk Score"
        },
        "observed_attack_techniques": {
          "items": {
            "type": "string"
          },
          "title": "Observed Attack Techniques",
          "type": "array"
        },
        "observed_incident_group_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Incident Group Id"
        },
        "observation_available": {
          "default": true,
          "title": "Observation Available",
          "type": "boolean"
        },
        "replay_notes": {
          "default": "",
          "maxLength": 512,
          "title": "Replay Notes",
          "type": "string"
        },
        "security": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecurityCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knowledge": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeCaseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "case_id",
        "slice_type"
      ],
      "title": "CaseObservation",
      "type": "object"
    },
    "EvaluationRunStatus": {
      "enum": [
        "completed",
        "failed",
        "unevaluable"
      ],
      "title": "EvaluationRunStatus",
      "type": "string"
    },
    "EvaluationScorerResult": {
      "additionalProperties": false,
      "description": "One scorer outcome for a single case.",
      "properties": {
        "scorer_id": {
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ScorerOutcome"
        },
        "reason_code": {
          "default": "",
          "maxLength": 128,
          "title": "Reason Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 512,
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "scorer_id",
        "outcome"
      ],
      "title": "EvaluationScorerResult",
      "type": "object"
    },
    "KnowledgeCaseObservation": {
      "additionalProperties": false,
      "description": "Structured knowledge replay observation for #642 knowledge slice scorers.",
      "properties": {
        "expectation_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expectation Kind",
          "type": "string"
        },
        "release_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Id"
        },
        "plan_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Hash"
        },
        "tenant_filter_applied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Filter Applied"
        },
        "citation_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Citation Chunk Ids",
          "type": "array"
        },
        "degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degraded"
        },
        "chunk_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Count"
        },
        "empty_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Empty Results"
        },
        "dependency_degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Degraded"
        }
      },
      "required": [
        "expectation_kind"
      ],
      "title": "KnowledgeCaseObservation",
      "type": "object"
    },
    "ScorerOutcome": {
      "description": "Typed scorer result; unevaluable/error never count as pass.",
      "enum": [
        "pass",
        "fail",
        "unevaluable",
        "error",
        "skipped"
      ],
      "title": "ScorerOutcome",
      "type": "string"
    },
    "SecurityCaseObservation": {
      "additionalProperties": false,
      "description": "Structured security replay observation for #642 security slice scorers.",
      "properties": {
        "expectation_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expectation Kind",
          "type": "string"
        },
        "cross_tenant_denied": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Tenant Denied"
        },
        "grant_forgery_rejected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grant Forgery Rejected"
        },
        "grant_budget_race_rejected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grant Budget Race Rejected"
        },
        "side_effect_blocked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side Effect Blocked"
        },
        "side_effect_unknown_contained": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side Effect Unknown Contained"
        },
        "prompt_injection_contained": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Injection Contained"
        },
        "production_store_mutated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Store Mutated"
        },
        "dependency_degraded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Degraded"
        }
      },
      "required": [
        "expectation_kind"
      ],
      "title": "SecurityCaseObservation",
      "type": "object"
    },
    "SliceType": {
      "description": "Evaluation slices; extend via reviewed schema revision only (#618 / #642).",
      "enum": [
        "threat",
        "benign",
        "unevaluable",
        "security",
        "knowledge"
      ],
      "title": "SliceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Aggregated per-case evaluation output.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "truth_id": {
      "minLength": 1,
      "title": "Truth Id",
      "type": "string"
    },
    "truth_revision": {
      "minimum": 1,
      "title": "Truth Revision",
      "type": "integer"
    },
    "truth_content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Truth Content Hash",
      "type": "string"
    },
    "slice_type": {
      "$ref": "#/$defs/SliceType"
    },
    "observation": {
      "$ref": "#/$defs/CaseObservation"
    },
    "scorer_results": {
      "items": {
        "$ref": "#/$defs/EvaluationScorerResult"
      },
      "title": "Scorer Results",
      "type": "array"
    },
    "case_status": {
      "$ref": "#/$defs/EvaluationRunStatus"
    },
    "unevaluable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unevaluable Reason"
    },
    "critical": {
      "default": false,
      "description": "When true, gate may fail closed regardless of aggregate pass_rate (#642).",
      "title": "Critical",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "truth_id",
    "truth_revision",
    "truth_content_hash",
    "slice_type",
    "observation",
    "case_status"
  ],
  "title": "EvaluationCaseResult",
  "type": "object"
}
