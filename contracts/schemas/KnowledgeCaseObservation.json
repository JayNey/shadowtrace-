    "degraded": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Degraded"
    },
    "chunk_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chunk Count"
    },
    "empty_results": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
