      "type": "string"
    },
    "release_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Id"
    },
    "plan_hash": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Hash"
    },
    "tenant_filter_applied": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Filter Applied"
    },
    "citation_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Citation Chunk Ids",
      "type": "array"
