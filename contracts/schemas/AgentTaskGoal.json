{
  "$defs": {
    "AgentTaskContextRef": {
      "additionalProperties": false,
      "description": "Allowlisted pointer to EventContext field or prior artifact.",
      "properties": {
        "ref_kind": {
          "enum": [
            "event_context_field",
            "artifact"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "AgentTaskContextRef",
      "type": "object"
    },
    "AgentTaskType": {
      "description": "Phase A task types — single coordinator, no DAG engine.",
      "enum": [
        "evidence_collect",
        "risk_score",
        "report_generate"
      ],
      "title": "AgentTaskType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned typed task input — not free-text instructions.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "maxLength": 16,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/AgentTaskType"
    },
    "context_refs": {
      "items": {
        "$ref": "#/$defs/AgentTaskContextRef"
      },
      "maxItems": 16,
      "title": "Context Refs",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "tool_call_grant_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Grant Id"
    }
  },
  "required": [
    "task_type"
  ],
  "title": "AgentTaskGoal",
  "type": "object"
}
