{
  "$defs": {
    "DetectionContextEvaluationRefs": {
      "additionalProperties": false,
      "description": "Evaluation artifact pins from governance binding.",
      "properties": {
        "evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "artifact_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Artifact Hash",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "dataset_content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Dataset Content Hash",
          "type": "string"
        },
        "code_sha": {
          "maxLength": 64,
          "minLength": 7,
          "title": "Code Sha",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "artifact_hash",
        "dataset_id",
        "dataset_version",
        "dataset_content_hash",
        "code_sha"
      ],
      "title": "DetectionContextEvaluationRefs",
      "type": "object"
    },
    "DetectionProductionCaseComparison": {
      "additionalProperties": false,
      "description": "Per-case shadow vs production outcome comparison.",
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "slice_type": {
          "$ref": "#/$defs/SliceType"
        },
        "shadow_case_status": {
          "$ref": "#/$defs/EvaluationRunStatus"
        },
        "shadow_candidate_count": {
          "default": 0,
          "minimum": 0,
          "title": "Shadow Candidate Count",
          "type": "integer"
        },
        "outcome_status": {
          "$ref": "#/$defs/DetectionProductionOutcomeStatus"
        },
        "promotion_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Id"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "candidate_detection_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Detection Id"
        },
        "production_severity": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Severity"
        },
        "coverage_ready_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Ready Count"
        },
        "coverage_total_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Total Count"
        },
        "drift_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Drift Reasons",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "slice_type",
        "shadow_case_status",
        "outcome_status"
      ],
      "title": "DetectionProductionCaseComparison",
      "type": "object"
    },
    "DetectionProductionComparisonConfig": {
      "additionalProperties": false,
      "description": "Frozen comparison configuration bound into the artifact.",
      "properties": {
        "phase_a_artifact_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Phase A Artifact Hash",
          "type": "string"
        },
        "phase_a_evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Phase A Evaluation Id",
          "type": "string"
        },
        "binding_manifest_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Binding Manifest Hash",
          "type": "string"
        },
        "comparison_fidelity": {
          "default": "production_post_promotion_v1",
          "description": "Production signals from #629 promotions + #633 context snapshots.",
          "minLength": 1,
          "title": "Comparison Fidelity",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "description": "Reserved comparison run seed for provenance (not used in diff logic).",
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "phase_a_artifact_hash",
        "phase_a_evaluation_id",
        "binding_manifest_hash"
      ],
      "title": "DetectionProductionComparisonConfig",
      "type": "object"
    },
    "DetectionProductionCoverageDrift": {
      "additionalProperties": false,
      "description": "Dataset-level production coverage drift rollup.",
      "properties": {
        "compared_case_count": {
          "default": 0,
          "minimum": 0,
          "title": "Compared Case Count",
          "type": "integer"
        },
        "production_ready_snapshot_total": {
          "default": 0,
          "minimum": 0,
          "title": "Production Ready Snapshot Total",
          "type": "integer"
        },
        "production_feature_snapshot_total": {
          "default": 0,
          "minimum": 0,
          "title": "Production Feature Snapshot Total",
          "type": "integer"
        },
        "production_insufficient_coverage_total": {
          "default": 0,
          "minimum": 0,
          "title": "Production Insufficient Coverage Total",
          "type": "integer"
        },
        "drift_detected": {
          "default": false,
          "title": "Drift Detected",
          "type": "boolean"
        },
        "drift_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Drift Reasons",
          "type": "array"
        }
      },
      "title": "DetectionProductionCoverageDrift",
      "type": "object"
    },
    "DetectionProductionOutcomeStatus": {
      "description": "Shadow vs production alignment for one evaluation case.",
      "enum": [
        "aligned",
        "drift",
        "missing_promotion",
        "unexpected_promotion",
        "snapshot_missing",
        "not_applicable"
      ],
      "title": "DetectionProductionOutcomeStatus",
      "type": "string"
    },
    "DetectionProductionRecommendationKind": {
      "description": "Advisory recommendation — not an approval or automatic rollback.",
      "enum": [
        "continue",
        "monitor",
        "rollback_recommended",
        "insufficient_data"
      ],
      "title": "DetectionProductionRecommendationKind",
      "type": "string"
    },
    "EvaluationRunStatus": {
      "enum": [
        "completed",
        "failed",
        "unevaluable"
      ],
      "title": "EvaluationRunStatus",
      "type": "string"
    },
    "SliceType": {
      "description": "Evaluation slices; extend via reviewed schema revision only (#618 / #642).",
      "enum": [
        "threat",
        "benign",
        "unevaluable",
        "security",
        "knowledge",
        "agentic",
        "coordination"
      ],
      "title": "SliceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable post-promotion comparison artifact (separate from Phase A).",
  "properties": {
    "comparison_id": {
      "minLength": 1,
      "title": "Comparison Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "code_sha": {
      "maxLength": 64,
      "minLength": 7,
      "title": "Code Sha",
      "type": "string"
    },
    "phase_a_refs": {
      "$ref": "#/$defs/DetectionContextEvaluationRefs"
    },
    "config": {
      "$ref": "#/$defs/DetectionProductionComparisonConfig"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EvaluationRunStatus"
    },
    "case_comparisons": {
      "items": {
        "$ref": "#/$defs/DetectionProductionCaseComparison"
      },
      "title": "Case Comparisons",
      "type": "array"
    },
    "coverage_drift": {
      "$ref": "#/$defs/DetectionProductionCoverageDrift"
    },
    "recommendation": {
      "$ref": "#/$defs/DetectionProductionRecommendationKind"
    },
    "recommendation_reasons": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Recommendation Reasons",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "artifact_hash": {
      "default": "",
      "maxLength": 64,
      "minLength": 0,
      "title": "Artifact Hash",
      "type": "string"
    },
    "advisory_note": {
      "default": "Advisory recommendation only; does not modify models/rules, governance state, or the Phase A evaluation artifact.",
      "maxLength": 512,
      "title": "Advisory Note",
      "type": "string"
    }
  },
  "required": [
    "comparison_id",
    "tenant_id",
    "code_sha",
    "phase_a_refs",
    "config",
    "started_at",
    "completed_at",
    "status",
    "recommendation"
  ],
  "title": "DetectionProductionComparisonArtifact",
  "type": "object"
}
