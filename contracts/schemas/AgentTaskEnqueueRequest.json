{
  "$defs": {
    "AgentTaskContextRef": {
      "additionalProperties": false,
      "description": "Allowlisted pointer to EventContext field or prior artifact.",
      "properties": {
        "ref_kind": {
          "enum": [
            "event_context_field",
            "artifact"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "ref_kind",
        "ref_id"
      ],
      "title": "AgentTaskContextRef",
      "type": "object"
    },
    "AgentTaskGoal": {
      "additionalProperties": false,
      "description": "Versioned typed task input — not free-text instructions.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "maxLength": 16,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "task_type": {
          "$ref": "#/$defs/AgentTaskType"
        },
        "context_refs": {
          "items": {
            "$ref": "#/$defs/AgentTaskContextRef"
          },
          "maxItems": 16,
          "title": "Context Refs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "tool_call_grant_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Grant Id"
        }
      },
      "required": [
        "task_type"
      ],
      "title": "AgentTaskGoal",
      "type": "object"
    },
    "AgentTaskType": {
      "description": "Phase A task types — single coordinator, no DAG engine.",
      "enum": [
        "evidence_collect",
        "risk_score",
        "response_plan",
        "report_generate"
      ],
      "title": "AgentTaskType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Trusted enqueue input.",
  "properties": {
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "goal": {
      "$ref": "#/$defs/AgentTaskGoal"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "tenant_id",
    "goal",
    "idempotency_key"
  ],
  "title": "AgentTaskEnqueueRequest",
  "type": "object"
}
