{
  "$defs": {
    "ConfidenceInterval": {
      "additionalProperties": false,
      "description": "Wilson score interval for a proportion metric.",
      "properties": {
        "lower": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Upper",
          "type": "number"
        },
        "level": {
          "default": 0.95,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Level",
          "type": "number"
        },
        "method": {
          "default": "wilson",
          "maxLength": 32,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ConfidenceInterval",
      "type": "object"
    },
    "EvaluationReleaseRefs": {
      "additionalProperties": false,
      "description": "Pinned release identifiers for reproducibility.",
      "properties": {
        "model_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Release Id"
        },
        "prompt_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Release Id"
        },
        "rule_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Release Id"
        },
        "kb_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Release Id"
        },
        "config_profile": {
          "default": "mock_p0",
          "minLength": 1,
          "title": "Config Profile",
          "type": "string"
        }
      },
      "title": "EvaluationReleaseRefs",
      "type": "object"
    },
    "GroupingScorerSummary": {
      "additionalProperties": false,
      "description": "Rollup for optional severity/ATT&CK/incident grouping scorers.",
      "properties": {
        "scorer_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Scorer Id",
          "type": "string"
        },
        "evaluated_count": {
          "minimum": 0,
          "title": "Evaluated Count",
          "type": "integer"
        },
        "pass_count": {
          "default": 0,
          "minimum": 0,
          "title": "Pass Count",
          "type": "integer"
        },
        "fail_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fail Count",
          "type": "integer"
        },
        "not_applicable_count": {
          "default": 0,
          "minimum": 0,
          "title": "Not Applicable Count",
          "type": "integer"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        }
      },
      "required": [
        "scorer_id",
        "evaluated_count"
      ],
      "title": "GroupingScorerSummary",
      "type": "object"
    },
    "MetricDenominator": {
      "additionalProperties": false,
      "description": "Explicit numerator/denominator with missing-truth and error accounting.",
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "missing_truth_count": {
          "default": 0,
          "minimum": 0,
          "title": "Missing Truth Count",
          "type": "integer"
        },
        "error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "MetricDenominator",
      "type": "object"
    },
    "QualityMetricStatus": {
      "description": "Whether a metric value is safe to interpret.",
      "enum": [
        "computed",
        "fail_closed",
        "insufficient_sample"
      ],
      "title": "QualityMetricStatus",
      "type": "string"
    },
    "QualityMetricValue": {
      "additionalProperties": false,
      "description": "One typed offline quality metric.",
      "properties": {
        "metric_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when status is fail_closed or insufficient_sample.",
          "title": "Value"
        },
        "status": {
          "$ref": "#/$defs/QualityMetricStatus"
        },
        "denominator": {
          "$ref": "#/$defs/MetricDenominator"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceInterval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "default": "",
          "maxLength": 256,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "status",
        "denominator"
      ],
      "title": "QualityMetricValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable offline quality report bound to one evaluation run.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "dataset_content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Dataset Content Hash",
      "type": "string"
    },
    "code_sha": {
      "maxLength": 64,
      "minLength": 7,
      "title": "Code Sha",
      "type": "string"
    },
    "release_refs": {
      "$ref": "#/$defs/EvaluationReleaseRefs"
    },
    "sample_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Sample Counts",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/QualityMetricValue"
      },
      "title": "Metrics",
      "type": "array"
    },
    "grouping_scorer_summaries": {
      "items": {
        "$ref": "#/$defs/GroupingScorerSummary"
      },
      "title": "Grouping Scorer Summaries",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "dataset_content_hash",
    "code_sha"
  ],
  "title": "EvaluationQualityReport",
  "type": "object"
}
