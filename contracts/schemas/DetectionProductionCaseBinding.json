{
  "additionalProperties": false,
  "description": "Fixture/manifest expectation for one promoted evaluation case.",
  "properties": {
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "expect_promotion": {
      "default": true,
      "title": "Expect Promotion",
      "type": "boolean"
    },
    "expected_production_severity": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Production Severity"
    },
    "min_coverage_ready_ratio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Coverage Ready Ratio"
    }
  },
  "required": [
    "case_id"
  ],
  "title": "DetectionProductionCaseBinding",
  "type": "object"
}
