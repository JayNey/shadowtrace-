{
  "$defs": {
    "MappingApprovalState": {
      "description": "Curated mappings only — model suggestions stay candidate until approved.",
      "enum": [
        "candidate",
        "approved"
      ],
      "title": "MappingApprovalState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable mapping row bound to one policy release.",
  "properties": {
    "mapping_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Mapping Id",
      "type": "string"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "technique_id": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Technique Id",
      "type": "string"
    },
    "control_id": {
      "pattern": "^ctrl-[0-9a-fA-F]{8}$",
      "title": "Control Id",
      "type": "string"
    },
    "framework_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Framework Id",
      "type": "string"
    },
    "approval_state": {
      "$ref": "#/$defs/MappingApprovalState"
    },
    "mapping_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "provenance": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    }
  },
  "required": [
    "mapping_id",
    "release_id",
    "technique_id",
    "control_id",
    "framework_id",
    "approval_state",
    "mapping_version",
    "provenance"
  ],
  "title": "AttackControlMapping",
  "type": "object"
}
