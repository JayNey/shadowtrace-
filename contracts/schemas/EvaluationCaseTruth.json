{
  "$defs": {
    "BenignSliceExpectation": {
      "additionalProperties": false,
      "description": "Expectation for confirmed-benign / false-positive cases.",
      "properties": {
        "slice_type": {
          "const": "benign",
          "default": "benign",
          "title": "Slice Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "expected_case_label": {
          "$ref": "#/$defs/CaseLabel",
          "default": "false_positive"
        },
        "expected_final_verdict": {
          "$ref": "#/$defs/FinalVerdict",
          "default": "false_positive"
        }
      },
      "title": "BenignSliceExpectation",
      "type": "object"
    },
    "CaseLabel": {
      "description": "Case-KB compatible label derived from FinalVerdict.",
      "enum": [
        "true_positive",
        "false_positive",
        "uncertain"
      ],
      "title": "CaseLabel",
      "type": "string"
    },
    "FinalVerdict": {
      "description": "Verdict label, independent from EventStatus.",
      "enum": [
        "none",
        "possible_false_positive",
        "false_positive",
        "confirmed_threat"
      ],
      "title": "FinalVerdict",
      "type": "string"
    },
    "LabelProvenance": {
      "additionalProperties": false,
      "description": "Who adjudicated the label and when — append-only across revisions.",
      "properties": {
        "adjudicator": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Adjudicator",
          "type": "string"
        },
        "adjudicated_at": {
          "format": "date-time",
          "title": "Adjudicated At",
          "type": "string"
        },
        "source_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source Kind",
          "type": "string"
        },
        "revision_notes": {
          "default": "",
          "maxLength": 512,
          "title": "Revision Notes",
          "type": "string"
        }
      },
      "required": [
        "adjudicator",
        "adjudicated_at",
        "source_kind"
      ],
      "title": "LabelProvenance",
      "type": "object"
    },
    "OperationalTruthMapping": {
      "additionalProperties": false,
      "description": "Maps semantic truth to operational anchors for shadow replay.\n\n``event_id`` / ``detection_id`` / ``disposition_id`` reference runtime\nEvent/Detection/Disposition state. They are evaluation anchors, **not**\nground truth. Never copy agent severity, verdict, or response outcome here.",
      "properties": {
        "mapping_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "detection_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Id"
        },
        "disposition_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition Id"
        },
        "notes": {
          "default": "",
          "maxLength": 256,
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "OperationalTruthMapping",
      "type": "object"
    },
    "ThreatSliceExpectation": {
      "additionalProperties": false,
      "description": "Expectation for confirmed-threat cases.",
      "properties": {
        "slice_type": {
          "const": "threat",
          "default": "threat",
          "title": "Slice Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "expected_case_label": {
          "$ref": "#/$defs/CaseLabel",
          "default": "true_positive"
        },
        "expected_final_verdict": {
          "$ref": "#/$defs/FinalVerdict",
          "default": "confirmed_threat"
        }
      },
      "title": "ThreatSliceExpectation",
      "type": "object"
    },
    "TruthObservationRef": {
      "additionalProperties": false,
      "description": "Immutable observation anchor (source object, scenario pack, etc.).",
      "properties": {
        "ref_type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Ref Type",
          "type": "string"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "source_product": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Product"
        },
        "connector_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connector Id"
        }
      },
      "required": [
        "ref_type",
        "ref_id"
      ],
      "title": "TruthObservationRef",
      "type": "object"
    },
    "UnevaluableSliceExpectation": {
      "additionalProperties": false,
      "description": "Explicit unevaluable slice — unknown truth must not default to benign.",
      "properties": {
        "slice_type": {
          "const": "unevaluable",
          "default": "unevaluable",
          "title": "Slice Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 512,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "reason_code"
      ],
      "title": "UnevaluableSliceExpectation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable revision of adjudicated case truth for offline evaluation.",
  "properties": {
    "truth_id": {
      "minLength": 1,
      "title": "Truth Id",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "source_tenant_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Tenant Id"
    },
    "source_product": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Product"
    },
    "connector_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connector Id"
    },
    "dataset_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "case_version": {
      "default": 1,
      "minimum": 1,
      "title": "Case Version",
      "type": "integer"
    },
    "content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "$ref": "#/$defs/TruthObservationRef"
      },
      "title": "Observation Refs",
      "type": "array"
    },
    "slice_expectation": {
      "discriminator": {
        "mapping": {
          "benign": "#/$defs/BenignSliceExpectation",
          "threat": "#/$defs/ThreatSliceExpectation",
          "unevaluable": "#/$defs/UnevaluableSliceExpectation"
        },
        "propertyName": "slice_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ThreatSliceExpectation"
        },
        {
          "$ref": "#/$defs/BenignSliceExpectation"
        },
        {
          "$ref": "#/$defs/UnevaluableSliceExpectation"
        }
      ],
      "title": "Slice Expectation"
    },
    "label_provenance": {
      "$ref": "#/$defs/LabelProvenance"
    },
    "operational_mapping": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationalTruthMapping"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "supersedes_truth_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Truth Id"
    },
    "correction_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Reason"
    },
    "retention_policy": {
      "default": "evaluation_standard",
      "minLength": 1,
      "title": "Retention Policy",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "truth_hash": {
      "default": "",
      "maxLength": 64,
      "minLength": 0,
      "title": "Truth Hash",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "truth_id",
    "tenant_id",
    "dataset_id",
    "dataset_version",
    "case_id",
    "content_hash",
    "slice_expectation",
    "label_provenance",
    "idempotency_key"
  ],
  "title": "EvaluationCaseTruth",
  "type": "object"
}
