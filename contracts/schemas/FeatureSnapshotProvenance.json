{
  "additionalProperties": false,
  "description": "Observation anchors included in the snapshot body.",
  "properties": {
    "observation_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "title": "Observation Ids",
      "type": "array"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "first_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Observed At"
    },
    "last_observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Observed At"
    }
  },
  "required": [
    "observation_count"
  ],
  "title": "FeatureSnapshotProvenance",
  "type": "object"
}
