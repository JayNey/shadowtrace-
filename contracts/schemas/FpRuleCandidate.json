{
  "$defs": {
    "EventType": {
      "description": "Supported security event types (intro §1); extensible via scenario packs.",
      "enum": [
        "account_anomaly",
        "host_compromise",
        "data_exfiltration",
        "insider_threat",
        "malicious_process",
        "suspicious_domain",
        "lateral_movement",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rule_summary": {
      "title": "Rule Summary",
      "type": "string"
    },
    "alert_signature": {
      "title": "Alert Signature",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "source_event_id": {
      "title": "Source Event Id",
      "type": "string"
    },
    "pending_review": {
      "default": true,
      "title": "Pending Review",
      "type": "boolean"
    },
    "review_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Id"
    },
    "event_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "rule_summary",
    "alert_signature",
    "confidence",
    "source_event_id"
  ],
  "title": "FpRuleCandidate",
  "type": "object"
}
