{
  "$defs": {
    "SecurityExpectationKind": {
      "description": "Typed security slice expectations (Phase A deterministic cases).",
      "enum": [
        "cross_tenant_denied",
        "grant_forgery_rejected",
        "grant_budget_race",
        "side_effect_blocked",
        "prompt_injection_contained",
        "production_isolation"
      ],
      "title": "SecurityExpectationKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Security gate expectations \u2014 cross-tenant, grant, side-effect, isolation.",
  "properties": {
    "slice_type": {
      "const": "security",
      "default": "security",
      "title": "Slice Type",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "expectation_kind": {
      "$ref": "#/$defs/SecurityExpectationKind"
    },
    "critical": {
      "default": true,
      "title": "Critical",
      "type": "boolean"
    },
    "expected_cross_tenant_denied": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Cross Tenant Denied"
    },
    "expected_grant_forgery_rejected": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Grant Forgery Rejected"
    },
    "expected_grant_budget_race_rejected": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Grant Budget Race Rejected"
    },
    "expected_side_effect_blocked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Side Effect Blocked"
    },
    "expected_prompt_injection_contained": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Prompt Injection Contained"
    },
    "expected_production_store_mutated": {
      "default": false,
      "title": "Expected Production Store Mutated",
      "type": "boolean"
    },
    "replay_variant": {
      "default": "pass",
      "maxLength": 32,
      "minLength": 1,
      "title": "Replay Variant",
      "type": "string"
    }
  },
  "required": [
    "expectation_kind"
  ],
  "title": "SecuritySliceExpectation",
  "type": "object"
}
