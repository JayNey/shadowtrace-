{
  "$defs": {
    "KnowledgeReleaseLifecycleState": {
      "description": "Release lifecycle — activation/retirement are server-owned transitions.",
      "enum": [
        "draft",
        "staged",
        "active",
        "retired",
        "failed"
      ],
      "title": "KnowledgeReleaseLifecycleState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable playbook version/hash reference — not a bare playbook_id string.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "playbook_id": {
      "pattern": "^pb-[0-9a-fA-F]{8}$",
      "title": "Playbook Id",
      "type": "string"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "release_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Release Version",
      "type": "string"
    },
    "content_hash": {
      "description": "SHA-256 of canonical playbook object JSON",
      "maxLength": 64,
      "minLength": 64,
      "title": "Content Hash",
      "type": "string"
    },
    "bundle_content_hash": {
      "description": "SHA-256 of canonical release bundle JSON",
      "maxLength": 64,
      "minLength": 64,
      "title": "Bundle Content Hash",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "corpus_id": {
      "default": "playbook_soar",
      "minLength": 1,
      "title": "Corpus Id",
      "type": "string"
    },
    "lifecycle_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeReleaseLifecycleState"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Release lifecycle at pin time (audit only)"
    }
  },
  "required": [
    "playbook_id",
    "release_id",
    "release_version",
    "content_hash",
    "bundle_content_hash"
  ],
  "title": "PlaybookRef",
  "type": "object"
}
