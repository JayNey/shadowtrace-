# ============================================================================
# ShadowTrace Compose 端口映射（ISSUE-088）
#
# 复制为 infra/.env 并修改端口即可覆盖 docker-compose.yml 中的 ${VAR} 默认值。
#
# 应用层环境变量（SOURCE_MODE、LLM_MODE、DATABASE_URL 等）见项目根目录
# `.env.example`（compose 的 backend/worker 会通过 env_file 加载该文件）。
# ============================================================================
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
MOCK_XDR_PORT=8100
OPENSEARCH_PORT=9200
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
