# Sangfor XDR cutover example (read-only probe / staging, NOT production Demo).
# Do not copy this over a Mock Demo .env. Do not use TOOL_MODE=mock on live events.
#
# L10 / investigation loop: TOOL_MODE=live + ALLOW_LIVE_SIDE_EFFECTS=true.
# BLOCK_LIVE_ACTION_EXECUTION blocks execute_plan / writeback, not query registration.
# Open writeback only after L10 is green: ALLOW_XDR_WRITEBACK=true and
# BLOCK_LIVE_ACTION_EXECUTION=false (still gated by approval / capability).

APP_ENV=staging
SOURCE_MODE=sangfor_xdr
DISPOSITION_MODE=live_xdr
DISPOSITION_ADAPTER_KIND=sangfor_xdr
SIMULATION_ENABLED=false
ALLOW_XDR_WRITEBACK=false
BLOCK_LIVE_ACTION_EXECUTION=true
TOOL_MODE=live
ALLOW_LIVE_SIDE_EFFECTS=true

# SANGFOR_XDR_BASE_URL=https://xdr.example.invalid
# SANGFOR_AUTH_CODE=
# or:
# SANGFOR_ACCESS_KEY=
# SANGFOR_SECRET_KEY=
# SHARED_CREDENTIAL_SCOPE_VERIFIED=true
# SANGFOR_TLS_VERIFY=true
#
# Overlay / Disposition share this inventory. Empty = no auto block/scan/ticket.
# SANGFOR_BLOCK_CHANNEL=network
# SANGFOR_DEVICES=[{"deviceId":"af-1","deviceType":"AF","deviceName":"AF_011"}]
# Ticket needs both template and assignees (AF alone is not enough):
# SANGFOR_TICKET_TEMPLATE_ID=incidentBulletin
# SANGFOR_TICKET_ASSIGNEE_IDS=user-1,user-2
# SANGFOR_HOST_IDENTIFIERS=
#
# Layer 10 first-contact (scripts/sangfor_xdr_first_contact.py), not Demo:
# Point SANGFOR_XDR_BASE_URL at either:
#   - local vendor wire mock:
#       cd backend && uv run python ../scripts/run_sangfor_wire_mock.py
#     (default http://127.0.0.1:18080) plus signing vectors AK/SK, or
#   - a staging/site XDR base URL (not /mock-xdr/v1).
# Missing BASE_URL or credentials → fail-closed, zero HTTP. Do not source .env.live.
# Default probe is read-only (incidents/list time window + blockdevice/list).
# Wire-mock green is not production cutover. TOOL_MODE=mock is Demo-only, not live-complete.
