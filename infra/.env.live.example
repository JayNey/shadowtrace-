# ============================================================================
# Live provider overrides (ISSUE-088)
#
# Usage:
#   cp infra/.env.live.example .env.live
#   # fill in credentials, then rebuild/restart stack
#
# Loaded automatically by compose when present (required: false).
#
# Live disposition registration requires a real endpoint and an uppercase
# environment variable name in DISPOSITION_CREDENTIAL_REF. Missing either
# fails closed (empty registry) — it does not fall back to Mock XDR.
# ALLOW_* below are overlay-only; application Settings defaults stay false.
# ============================================================================
SIMULATION_ENABLED=false
LLM_MODE=openai_compatible
# Chat-completions prefix, e.g. Volcengine Ark: https://ark.cn-beijing.volces.com/api/v3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
SOURCE_MODE=live_crowdstrike
DISPOSITION_MODE=live
DISPOSITION_ADAPTER_KIND=generic_http_disposition
# Outbox lookup uses SourceObject.source_product, not the adapter kind.
# Set this to the live event product (for example crowdstrike) so the same
# adapter is also registered under that name. Unregistered products stay fenced
# and are not silently aliased to DISPOSITION_ADAPTER_KIND.
DISPOSITION_SOURCE_PRODUCT=
DISPOSITION_BASE_URL=
DISPOSITION_CREDENTIAL_REF=
DISPOSITION_AUTH_TYPE=bearer
TOOL_MODE=live
ALLOW_LIVE_SIDE_EFFECTS=true
BLOCK_LIVE_ACTION_EXECUTION=false
ALLOW_XDR_WRITEBACK=true
